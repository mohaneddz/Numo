{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    // ES2022.Error only, for `new Error(msg, { cause })`. The emit target stays
    // ES2020; this just makes the type available.
    "lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Without this, installing @types/node (or any @types/* package, e.g. for
       scripts/ tooling) silently adds Node globals like `process` and `Buffer` to
       every file's typecheck, even though this app ships to a browser/Tauri
       webview where those globals do not exist. `vite-env.d.ts` explicitly
       references `vite/client` for import.meta.env, so that keeps working. */
    "types": [],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
