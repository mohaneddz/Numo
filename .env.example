# Copy this file to .env.local (preferred, git-ignored) or .env and fill in
# whatever you have. Every key here is optional at build time — features that
# need a given key degrade to their offline/local fallback (or an explicit
# "not configured" state in Settings) when it's missing.

# --- Groq (cloud LLM / speech-to-text / text-to-speech) ---
# Powers Chat, Learn/Review/Write/Speak grading and generation, and the
# Exercises dev tool. Get a key at https://console.groq.com
VITE_GROQ_API_KEY=
VITE_GROQ_BASE_URL=https://api.groq.com/openai/v1
VITE_GROQ_CHAT_MODEL=llama-3.3-70b-versatile
VITE_GROQ_STT_MODEL=whisper-large-v3
VITE_GROQ_TTS_MODEL=playai-tts
VITE_GROQ_TTS_VOICE=Fritz-PlayAI

# --- Immersion media search (background art, Immerse page) ---
# Any subset works; providers without a key are skipped, not faked.
VITE_UNSPLASH_ACCESS_KEY=
VITE_PEXELS_API_KEY=
VITE_PIXABAY_API_KEY=

# --- YouTube Data API v3 (Immerse video/audio metadata) ---
# Also configurable at runtime from Settings -> Integrations.
VITE_YOUTUBE_API_KEY=

# --- Dev-only ---
# Enables the in-app DebugPanel and other dev-mode affordances.
VITE_DEV_MODE=true
